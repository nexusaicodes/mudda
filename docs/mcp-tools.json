  {
    "name": "list_cards",
    "title": "List cards",
    "description": "Cards across every board, or on one board when `board_id` is given; the filters narrow\neither. To read one lane, pass its column id (from `get_board`) in `column_ids`, or name it\nin `lane` to read that lane on every board. `due: \"soon\"` gives the open cards due by\ntomorrow, the most overdue first. Paged: follow paging.next or pass `page`.\n",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "board_id": {
          "type": "integer",
          "description": "Only this board's cards"
        },
        "board_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "column_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "card_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Full-text terms"
        },
        "creation": {
          "type": "string",
          "enum": [
            "today",
            "yesterday",
            "thisweek",
            "thismonth",
            "thisyear",
            "lastweek",
            "lastmonth",
            "lastyear"
          ],
          "description": "When the card was created"
        },
        "due": {
          "type": "string",
          "enum": [
            "soon"
          ],
          "description": "soon: open cards due by tomorrow, overdue first"
        },
        "lane": {
          "type": "string",
          "enum": [
            "backlog",
            "todo",
            "doing",
            "done"
          ],
          "description": "A lane by name, on every board"
        },
        "indexed_by": {
          "type": "string",
          "enum": [
            "all",
            "pinned"
          ]
        },
        "sorted_by": {
          "type": "string",
          "enum": [
            "latest",
            "newest",
            "oldest"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "scope": "read",
    "calls": [
      {
        "method": "GET",
        "path": "/cards.json"
      },
      {
        "method": "GET",
        "path": "/boards/{board_id}/cards.json"
      }
    ]
  },
  {
    "name": "get_card",
    "title": "Get a card",
    "description": "The whole card: its fields, board, column, every step, and its 20 most recent notes. When\n`notes_truncated` is true, `list_notes` pages through the rest.\n",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "board_id": {
          "type": "integer",
          "description": "The board the card is on"
        },
        "number": {
          "type": "integer",
          "description": "The card's number on that board (not its id)"
        }
      },
      "required": [
        "board_id",
        "number"
      ],
      "additionalProperties": false,
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "scope": "read",
    "calls": [
      {
        "method": "GET",
        "path": "/boards/{board_id}/cards/{number}.json"
      }
    ]
  },
  {
    "name": "create_card",
    "title": "Create a card",
    "description": "Creates a card, complete, in the board's Backlog column. `due_on` is optional there, and\nrequired before the card moves to Todo or Doing. Steps are created with it, in order.\nThe result carries the card's `number`, which together with the board addresses it from\nnow on.\n",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "board_id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "due_on": {
          "type": "string",
          "format": "date",
          "description": "YYYY-MM-DD"
        },
        "description": {
          "type": "string",
          "description": "Rich text; plain text or HTML"
        },
        "pinned": {
          "type": "boolean",
          "description": "Pinned to the top of its lane"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Checklist steps, in order"
        }
      },
      "required": [
        "board_id",
        "title"
      ],
      "additionalProperties": false,
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "scope": "write",
    "calls": [
      {
        "method": "POST",
        "path": "/boards/{board_id}/cards.json"
      }
    ]
  },
  {
    "name": "update_card",
    "title": "Update a card",
    "description": "Changes any of a card's fields in one write — all of it applies or none of it does. Move\nit between lanes with `column_id` (a column of the board it ends up on). Move it to\nanother board with `to_board_id`: it is renumbered there, so use the `number` and `url`\nin the result from then on; with no `column_id` it lands in that board's Backlog. In Todo\nand Doing a card needs a `due_on`, so set one in the same write that moves it there. Steps:\nan entry with no `id` adds one; with an `id` it edits that step, or removes it when\n`remove` is true.\n",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "board_id": {
          "type": "integer",
          "description": "The board the card is on"
        },
        "number": {
          "type": "integer",
          "description": "The card's number on that board (not its id)"
        },
        "title": {
          "type": "string"
        },
        "due_on": {
          "type": "string",
          "format": "date",
          "description": "YYYY-MM-DD"
        },
        "description": {
          "type": "string",
          "description": "Rich text; replaces the whole description"
        },
        "pinned": {
          "type": "boolean",
          "description": "Pinned to the top of its lane"
        },
        "column_id": {
          "type": "integer",
          "description": "The lane to move the card to"
        },
        "to_board_id": {
          "type": "integer",
          "description": "The board to move the card to"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "content": {
                "type": "string"
              },
              "completed": {
                "type": "boolean"
              },
              "remove": {
                "type": "boolean",
                "description": "Delete this step; needs the delete scope"
              }
            }
          }
        }
      },
      "required": [
        "board_id",
        "number"
      ],
      "additionalProperties": false,
      "type": "object"
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "scope": "write",
    "calls": [
      {
        "method": "PUT",
        "path": "/boards/{board_id}/cards/{number}.json"
      }
    ]
  },
  {
    "name": "delete_card",
