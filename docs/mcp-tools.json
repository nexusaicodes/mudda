  {
    "name": "get_board",
    "title": "Get a board",
    "description": "One board with its four fixed columns, in order: Backlog, Todo, Doing, Done.\nColumn ids from here are what `update_card` takes as `column_id` and `list_cards` as\n`column_ids`.\n",
