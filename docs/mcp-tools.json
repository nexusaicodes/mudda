  {
    "name": "search_cards",
    "title": "Search cards",
    "description": "Full-text search over card titles, descriptions, and notes across every board. A card\nnumber is searched as plain text; fetch a card by its number with get_card. Paged: follow\npaging.next or pass `page`.\n",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "q": {
          "type": "string",
          "description": "The search text"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "q"
      ],
      "additionalProperties": false,
      "type": "object"
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "scope": "read",
    "calls": [
      {
        "method": "GET",
        "path": "/search.json"
      }
    ]
  },
