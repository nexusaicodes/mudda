<div class="board-tools card">
  <%= link_to new_board_card_path(board), class: "btn btn--link",
        data: { turbo_frame: "_top", controller: "hotkey", action: "keydown.c@document->hotkey#click" } do %>
    <%= icon_tag "add", class: "show-on-touch" %>
    <span>Add a card</span>
    <kbd class="hide-on-touch">C</kbd>
  <% end %>
</div>
