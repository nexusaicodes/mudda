<%# locals: (board:, due_soon:) -%>
<div class="board-tools flex flex-wrap items-center justify-center gap-2 py-3 max-sm:py-2">
  <% if board.account.card_limit_reached? %>
    <span class="text-sm"><%= t(".limit_reached", count: board.account.card_limit) %></span>
    <% if upgrade_url = board.account.upgrade_url %>
      <%= link_to t(".upgrade"), upgrade_url, class: "btn btn-primary max-sm:btn-sm", data: { turbo: false } %>
    <% end %>
  <% else %>
    <%= link_to new_board_card_path(board), class: "btn btn-primary max-sm:btn-sm", data: { turbo_frame: "_top" } do %>
      <%= icon_tag "add" %>
      <span><%= t(".add") %></span>
    <% end %>
  <% end %>
  <%= render "boards/show/due_toggle", board: board, due_soon: due_soon %>
</div>
