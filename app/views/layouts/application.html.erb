<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= html_direction %>">
  <%= render "layouts/shared/head" %>

  <body class="min-h-dvh flex flex-col <%= @body_class %>"
    data-controller="local-time timezone-cookie turbo-navigation"
    data-action="turbo:morph@window->local-time#refreshAll turbo:before-visit@document->turbo-navigation#rememberLocation"
    data-turbo-navigation-label-value="<%= @page_title %>"
    data-turbo-navigation-back-template-value="<%= t("back_link.label", label: "%{label}") %>">
    <div id="global-container" class="contents">
      <%# The header sits inside the paper's frame; it rises above the page while one of its dialogs is open. %>
      <header id="header" class="navbar grid grid-cols-[1fr_minmax(0,max-content)_1fr] relative z-(--z-nav) has-[dialog[open]]:z-(--z-nav-open) gap-2 min-h-0 px-[calc(var(--paper-clearance)+var(--custom-safe-inset-left))] pt-[calc(var(--paper-clearance)+var(--custom-safe-inset-top))] pb-2 <%= @header_class %>">
        <a href="#main" class="btn btn-sm sr-only focus:not-sr-only focus:absolute focus:top-16 focus:start-4" data-turbo="false"><%= t(".skip") %></a>
        <% if Current.user %>
          <div class="col-start-1 flex items-center gap-1 min-w-0">
            <%= render "layouts/shared/home_link" %>
            <%= yield :header_start %>
          </div>
        <% end %>

        <div class="col-start-2 flex justify-center min-w-0">
          <%= yield :header %>
        </div>

        <% if Current.user %>
          <div class="col-start-3 flex items-center justify-end gap-1">
            <div id="header_search" data-turbo-permanent="true">
              <%= render "bar/bar" %>
            </div>
            <%= render "my/account_link" %>
          </div>
        <% end %>
      </header>

      <%= render "layouts/shared/flash" %>
      <%= render "layouts/shared/time_zone" if Current.user %>

      <main id="main" class="flex-1 flex flex-col w-full text-center px-[calc(var(--paper-clearance)+var(--custom-safe-inset-left))] pb-[calc(var(--paper-clearance)+var(--custom-safe-inset-bottom))]">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
