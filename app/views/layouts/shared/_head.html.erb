<head>
  <%= page_title_tag %>

  <meta name="description" content="<%= t("meta.description") %>">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover">
  <% unless @disable_view_transition %>
    <meta name="view-transition" content="same-origin">
  <% end %>
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="<%= MuddaTheme::PALETTE[:light][:paper] %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= tag.meta name: "current-user-id", content: Current.user.id if Current.user %>

  <% turbo_refreshes_with method: :morph, scroll: :preserve %>

  <%= stylesheet_link_tag "tailwind", "lexxy", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
  <%= favicon_link_tag "mudda_theme/mark.svg", type: "image/svg+xml" %>
  <%= favicon_link_tag "mudda_theme/apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>
</head>
