<% @page_title = t(".title") %>

<div class="card bg-base-100 shadow-sm w-full max-w-2xl mx-auto p-6 text-start gap-4 flex-none">
  <h1 class="text-lg font-bold m-0"><%= t(".heading") %></h1>

  <p class="m-0">
    <%= local_assigns[:message] || (local_assigns[:error_response] || @pre_auth.error_response).body[:error_description] %>
  </p>

  <p class="text-sm text-base-content/60 m-0"><%= t(".retry_html", link: link_to(t(".back"), root_path)) %></p>
</div>
