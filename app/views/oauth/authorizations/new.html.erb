<% @page_title = t(".title", client: @pre_auth.client.name) %>
<% redirect = URI.parse(@pre_auth.redirect_uri.to_s) rescue nil %>
<% request_fields = { client_id: @pre_auth.client.uid, redirect_uri: @pre_auth.redirect_uri, state: @pre_auth.state,
     response_type: @pre_auth.response_type, response_mode: @pre_auth.response_mode, scope: @pre_auth.scope,
     code_challenge: @pre_auth.code_challenge, code_challenge_method: @pre_auth.code_challenge_method,
     resource: params[:resource] } %>

<div class="card bg-base-100 shadow-sm w-full max-w-2xl mx-auto p-6 text-start gap-4 flex-none">
  <h1 class="text-lg font-bold m-0"><%= t(".heading_html", client: tag.strong(@pre_auth.client.name, dir: "auto")) %></h1>

  <p class="m-0">
    <%= t(".acts_as_html", user: tag.span(Current.user.name, dir: "auto"), client: tag.strong(@pre_auth.client.name, dir: "auto"),
          link: link_to(t(".tokens_link"), my_tokens_path)) %>
  </p>

  <p class="text-sm text-base-content/60 m-0">
    <%= t(".redirect_html", host: tag.strong(redirect&.host.presence || @pre_auth.redirect_uri, dir: "ltr")) %>
  </p>

  <%= form_tag oauth_authorization_path, method: :post, data: { turbo: false }, class: "flex flex-col gap-4" do %>
    <% request_fields.each do |name, value| %>
      <%= hidden_field_tag name, value, id: nil %>
    <% end %>

    <fieldset class="fieldset p-0 gap-2">
      <legend class="fieldset-legend"><%= t(".allow_legend") %></legend>
      <% scope_descriptions(@pre_auth.scopes.to_a).each do |scope, description| %>
        <label class="flex items-center gap-2">
          <%= check_box_tag "granted_scopes[]", scope, true, id: "granted_scope_#{scope}", class: "checkbox checkbox-sm" %>
          <span><%= description %></span>
        </label>
      <% end %>
    </fieldset>

    <%= submit_tag t(".allow"), class: "btn btn-primary self-center" %>
  <% end %>

  <%= form_tag oauth_authorization_path, method: :delete, data: { turbo: false }, class: "text-center" do %>
    <% request_fields.each do |name, value| %>
      <%= hidden_field_tag name, value, id: nil %>
    <% end %>
    <%= submit_tag t(".deny"), class: "btn btn-ghost btn-sm" %>
  <% end %>
</div>
