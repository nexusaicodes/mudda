<%= turbo_frame_tag "board_picker" do %>
  <%= tag.div class: "flex flex-col gap-2", data: {
        action: "turbo:before-cache@document->dialog#close dialog:show@document->navigable-list#reset keydown->navigable-list#navigate filter:changed->navigable-list#reset",
        controller: "filter navigable-list",
        dialog_target: "dialog",
        navigable_list_focus_on_selection_value: false,
        navigable_list_actionable_items_value: true } do %>
    <%= filter_title t(".title") %>

    <%= text_field_tag :search, nil, placeholder: t(".filter"), class: "input input-sm w-full", autofocus: true,
          type: "search", autocorrect: "off", autocomplete: "off", aria: { label: t(".filter") }, data: { "1p-ignore": "true", filter_target: "input", dialog_target: "focusMouse", action: "input->filter#filter" } %>

    <%# button_to puts a form between the row and its button, so the rows are styled here, not by daisyUI's menu. %>
    <ul class="flex flex-col gap-0.5 max-h-72 overflow-y-auto text-sm" data-filter-target="list">
      <% @boards.each do |board| %>
        <% current = @card.board == board %>
        <li class="aria-selected:[&_button]:bg-base-200" data-filter-target="item" data-navigable-list-target="item" aria-checked="<%= current %>">
          <%= button_to board_card_path(@card.board, @card, params: { card: { board_id: board.id } }), method: :patch,
                class: class_names("flex w-full items-center justify-between gap-2 rounded-field px-3 py-1.5 cursor-pointer text-start hover:bg-base-200", "bg-neutral text-neutral-content hover:bg-neutral": current),
                form_class: "w-full" do %>
            <span class="truncate" dir="auto"><%= board.name %></span>
            <%= icon_tag "check" if current %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
