<%# Shown only under a card ceiling (MUDDA_CARD_LIMIT), and only once it's close. %>
<% if account.card_limit_near? %>
  <p class="txt-small <%= "txt-negative" if account.card_limit_reached? %>">
    <% if account.card_limit_reached? %>
      <%= t(".reached", limit: account.card_limit) %>
    <% else %>
      <%= t(".remaining", count: account.cards_remaining, limit: account.card_limit) %>
    <% end %>

    <% if account.upgrade_url %>
      <%= link_to t(".upgrade"), account.upgrade_url, class: "btn btn--link", data: { turbo: false } %>
    <% end %>
  </p>
<% end %>
