<% show_board = local_assigns.fetch(:show_board, true) %>
<% show_lane = local_assigns.fetch(:show_lane, true) %>
<%= render partial: "cards/display/preview", collection: cards, as: :card, locals: { draggable: local_assigns.fetch(:draggable, false), show_board: show_board, show_lane: show_lane }, cached: ->(card) { [ card, Date.current, show_board, show_lane ] } %>
