<div class="card__meta flex items-center gap-3 text-xs text-base-content/70" id="<%= dom_id(card, :meta) %>">
  <%= avatar_tag card.creator, size: "w-8", tabindex: 0 %>

  <div class="flex flex-col gap-0.5 min-w-0">
    <span><%= t(".added_html", time: local_datetime_tag(card.created_at, style: :daysago)) %> · <%= t(".by_html", name: card.creator.familiar_name) %></span>
    <span class="flex items-center gap-1 truncate">
      <%= icon_tag "refresh--meta" %>
      <%= t(".updated_html", time: local_datetime_tag(card.last_active_at, style: :daysago)) %>
    </span>
  </div>
</div>
