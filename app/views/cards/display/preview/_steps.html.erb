<% if card.steps.any? %>
  <% completed, total = card.steps.completed.count, card.steps.count %>
  <span class="card__steps <%= "card__steps--complete" if completed == total %>" title="<%= completed %> of <%= total %> steps done">
    <%= icon_tag "check" %>
    <%= completed %>/<%= total %>
  </span>
<% end %>
