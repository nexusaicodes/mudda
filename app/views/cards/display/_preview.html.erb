<% card_data = {
  id: card.number,
  drag_and_drop_target: "item",
  navigable_list_target: "item",
  css_variable_counter_target: "item"
} %>

<% if card.open? %>
  <% card_data[:action] = "mouseenter->navigable-list#hoverSelect" %>
<% end %>

<%= card_article_tag card, class: "card", draggable: draggable, data: card_data, tabindex: 0 do %>
  <%= link_to board_card_path(card.board, card), draggable: false, class: "card__link", title: card_title_tag(card), data: { action: "dialog#close", turbo_frame: "_top" } do %>
    <span class="for-screen-reader"><%= card.title %></span>
  <% end %>

  <div class="card__body">
    <div class="card__content">
      <h3 class="card__title overflow-line-clamp" dir="auto">
        <%= card_html_title(card) %>
      </h3>

      <% if (excerpt = format_excerpt(card.description, length: 160)).present? %>
        <p class="card__excerpt overflow-line-clamp" dir="auto"><%= excerpt %></p>
      <% end %>
    </div>

    <%= render "cards/display/preview/columns", card: card %>
    <%= render "cards/display/common/stamp", card: card %>
  </div>

  <%= render "cards/display/preview/meta", card: card, show_lane: show_lane %>
<% end %>
