<% card_data = {
  id: card.number,
  drag_and_drop_target: "item",
  navigable_list_target: "item"
} %>

<% if card.open? %>
  <% card_data[:action] = "mouseenter->navigable-list#hoverSelect" %>
<% end %>

<%# A preview is a daisyUI card with the lane's colour down its leading edge; the whole card links to it. %>
<%= card_article_tag card, class: "card card-sm relative bg-base-100 shadow-sm border-s-4 border-(--card-color) text-start", draggable: draggable, data: card_data, tabindex: 0 do %>
  <%= link_to board_card_path(card.board, card), draggable: false, class: "absolute inset-0 z-[1] rounded-box", title: card_title_tag(card), data: { action: "dialog#close", turbo_frame: "_top" } do %>
    <span class="sr-only"><%= card.title %></span>
  <% end %>

  <div class="card-body gap-1">
    <h3 class="card__title font-semibold leading-snug" dir="auto">
      <%= card_html_title(card) %>
    </h3>

    <% if (excerpt = format_excerpt(card.description, length: 160)).present? %>
      <p class="card__excerpt text-xs text-base-content/70" dir="auto"><%= excerpt %></p>
    <% end %>

    <%= render "cards/display/common/stamp", card: card %>
    <%= render "cards/display/preview/meta", card: card, show_lane: show_lane %>
  </div>
<% end %>
