<% cache note do %>
  <%= turbo_frame_tag note, :container do %>
    <div id="<%= dom_id(note) %>" data-creator-id="<%= note.creator_id %>" class="note align-start full-width">
      <figure class="note__avatar flex-item-no-shrink" aria-hidden="true">
        <%= avatar_tag note.creator, hidden_for_screen_reader: true %>
      </figure>

      <div class="note__content flex flex-column flex-item-grow full-width">
        <div class="note__author flex align-center gap-half">
          <h3 class="font-weight-normal txt-normal flex-item-justify-start min-width overflow-ellipsis">
            <strong>
              <%= link_to note.creator.name, note.creator, class: "txt-ink btn btn--plain fill-transparent", data: { turbo_frame: "_top" } %>
            </strong>

            <%= link_to note, class: "note__permalink-title", data: { turbo_frame: "_top" } do %>
              <%= local_datetime_tag note.created_at, style: :agoorweekday %>,
              <%= local_datetime_tag note.created_at, style: :time %>
            <% end %>
          </h3>

          <%= link_to edit_card_note_path(note.card, note),
                class: "note__edit btn btn--circle borderless translucent", data: { only_visible_to_you: true } do %>
            <%= icon_tag "menu-dots-horizontal" %>
            <span class="for-screen-reader">Edit this note</span>
          <% end %>
        </div>

        <div class="note__body lexxy-content" data-controller="syntax-highlight retarget-links" data-turbo-permanent>
          <%= note.body %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
