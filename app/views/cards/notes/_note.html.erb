<% cache [ note, I18n.locale ] do %>
  <%= turbo_frame_tag note, :container do %>
    <div id="<%= dom_id(note) %>" class="note flex items-start gap-3 w-full">
      <div class="shrink-0" aria-hidden="true">
        <%= avatar_tag note.creator, hidden_for_screen_reader: true %>
      </div>

      <div class="card card-sm bg-base-100 shadow-sm grow min-w-0">
        <div class="card-body gap-2">
          <div class="flex items-center gap-2 min-w-0">
            <h3 class="text-sm grow min-w-0 truncate">
              <strong>
                <%= link_to note.creator.name, note.creator, class: "link link-hover", dir: "auto", data: { turbo_frame: "_top" } %>
              </strong>
              <%= link_to note, class: "link link-hover text-base-content/60", data: { turbo_frame: "_top" } do %>
                <%= local_datetime_tag note.created_at, style: :agoorweekday %>,
                <%= local_datetime_tag note.created_at, style: :time %>
              <% end %>
            </h3>

            <%= link_to edit_board_card_note_path(note.card.board, note.card, note),
                  class: "note__edit btn btn-ghost btn-circle btn-xs", aria: { label: t(".edit") } do %>
              <%= icon_tag "menu-dots-horizontal" %>
            <% end %>
          </div>

          <div class="note__body lexxy-content" dir="auto" data-controller="syntax-highlight retarget-links" data-turbo-permanent>
            <%= note.body %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
