<div id="<%= dom_id(card, :new_note) %>" class="note note--new flex items-start gap-3 w-full">
  <div class="shrink-0" aria-hidden="true">
    <%= avatar_tag Current.user, hidden_for_screen_reader: true %>
  </div>

  <div class="card card-sm bg-base-100 shadow-sm grow min-w-0">
    <div class="card-body" data-turbo-permanent>
      <%= form_with model: Note.new, url: board_card_notes_path(card.board, card), class: "flex flex-col gap-3",
            data: { controller: "form local-save",
                  local_save_key_value: "note-#{card.id}",
                  action: "turbo:submit-end->local-save#submit turbo:submit-end->form#blurActiveInput keydown.ctrl+enter->form#debouncedSubmit:prevent keydown.meta+enter->form#debouncedSubmit:prevent keydown.esc->form#cancel:stop" } do |form| %>
        <%= form.rich_textarea :body, required: true, dir: "auto", placeholder: new_note_placeholder(card),
              data: { local_save_target: "input", action: "lexxy:change->form#disableSubmitWhenInvalid lexxy:change->local-save#save turbo:morph-element->local-save#restore" } do %>
          <%= general_prompts(@card.board) %>
        <% end %>

        <div>
          <%= form.button class: "note__submit btn btn-neutral btn-sm",
              data: { form_target: "submit" }, disabled: true do %>
            <span><%= t(".post") %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
