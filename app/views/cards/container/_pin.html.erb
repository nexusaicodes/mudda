<% label = card.pinned? ? t(".unpin") : t(".pin") %>
<div class="tooltip" data-tip="<%= label %>">
  <%= button_to board_card_pin_path(card.board, card), method: (card.pinned? ? :delete : :post),
        class: class_names("btn btn-circle", card.pinned? ? "btn-warning" : "btn-ghost bg-base-100"), aria: { label: label, pressed: card.pinned? } do %>
    <%= icon_tag "pin" %>
  <% end %>
</div>
