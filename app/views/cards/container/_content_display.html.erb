<h1 class="card__title text-2xl font-bold leading-tight">
  <%= link_to card_html_title(card), edit_board_card_path(card.board, card), class: "card__title-link hover:underline", dir: "auto" %>
</h1>

<% unless card.description.blank? %>
  <div class="card__description lexxy-content" dir="auto" data-controller="syntax-highlight retarget-links">
    <%= card.description %>
  </div>
<% end %>
