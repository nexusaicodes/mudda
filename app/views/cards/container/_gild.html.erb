<% if card.golden? %>
  <%= button_to board_card_goldness_path(card.board, card), method: :delete, class: "btn btn--reversed btn--circle-mobile",
        data: { controller: "tooltip" } do %>
    <%= icon_tag "golden-ticket" %>
    <span class="for-screen-reader">Demote to normal</span>
  <% end %>
<% else %>
  <%= button_to board_card_goldness_path(card.board, card), class: "btn btn--circle-mobile",
        data: { controller: "tooltip" } do %>
    <%= icon_tag "golden-ticket" %>
    <span class="for-screen-reader">Promote to Golden Ticket</span>
  <% end %>
<% end %>
