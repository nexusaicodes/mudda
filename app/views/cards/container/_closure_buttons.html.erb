<div class="flex flex-wrap justify-center gap-2">
  <%= link_to edit_board_card_path(card.board, card), class: "btn",
        data: { turbo_frame: dom_id(card, :edit) } do %>
    <%= icon_tag "pencil" %>
    <span><%= t(".edit") %></span>
  <% end %>

  <% if (done_column = card.board.done_column) && !card.closed? %>
    <%= button_to board_card_column_path(card.board, card, column_id: done_column.id), method: :patch,
          class: "btn btn-primary",
          data: { form_target: "submit", turbo_frame: "_top" },
          form: { data: { controller: "form" } } do %>
      <%= icon_tag "check" %>
      <span class="truncate"><%= t(".mark_as", lane: lane_name(done_column)) %></span>
    <% end %>
  <% end %>
</div>
