<div data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="btn btn-sm text-error" data-action="dialog#open">
    <%= icon_tag "trash" %>
    <span><%= t(".delete_this_card") %></span>
  </button>
  <dialog class="modal" data-dialog-target="dialog">
    <div class="modal-box text-start">
      <h3 class="text-lg font-bold"><%= t(".title") %></h3>
      <p class="py-3"><%= t(".confirm") %></p>
      <div class="modal-action">
        <button type="button" class="btn" data-action="dialog#close"><%= t(".cancel") %></button>
        <%= button_to board_card_path(card.board, card), method: :delete, class: "btn btn-error", data: { turbo_frame: "_top" } do %>
          <span><%= t(".delete_card") %></span>
        <% end %>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button><%= t(".cancel") %></button></form>
  </dialog>
</div>
