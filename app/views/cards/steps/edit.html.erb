<%= turbo_frame_tag @step do %>
  <div class="flex items-center gap-2">
    <%= form_with model: [@card.board, @card, @step], class: "flex items-center gap-2 grow min-w-0", data: { controller: "form" } do |form| %>
      <%= form.check_box :completed, { class: "checkbox checkbox-sm", checked: @step.completed?, disabled: true } %>
      <%= form.text_field :content, class: "step__content input input-sm grow", placeholder: t(".placeholder"), dir: "auto", required: true, autofocus: true, autocomplete: "off",
          aria: { label: t(".placeholder") }, data: { action: "keydown.esc->form#cancel focus->form#select", "1p-ignore": "true" } %>
      <%= form.button type: "submit", class: "btn btn-success btn-sm btn-square", aria: { label: t(".save") } do %>
        <%= icon_tag "check" %>
      <% end %>
      <%= link_to t(".cancel"), board_card_step_path(@card.board, @card, @step), data: { form_target: "cancel" }, hidden: true %>
    <% end %>
    <%= button_to board_card_step_path(@card.board, @card, @step), method: :delete, class: "btn btn-ghost btn-sm btn-square text-error", aria: { label: t(".delete") } do %>
      <%= icon_tag "trash" %>
    <% end %>
  </div>
<% end %>
