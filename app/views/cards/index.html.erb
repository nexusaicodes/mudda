<% @page_title = @filter.view_name || @filter.boards_label %>
<% turbo_exempts_page_from_cache %>

<% content_for :header do %>
  <div class="header__title board-title">
    <div class="board-title__display">
      <h1 class="board-title__name">
        <span class="overflow-ellipsis txt-capitalize-first-letter"><%= @page_title %></span>
      </h1>
      <%= render "my/switcher", board: @single_board, view: @filter.view&.key %>
    </div>
  </div>
<% end %>

<%# Cards grouped under their board; a list narrowed to one board needs no headings, and a
    board carried over from the page before already has one. %>
<%= turbo_frame_tag :cards_container do %>
  <section class="card-groups">
    <%= with_automatic_pagination :cards_paginated_container, @page do %>
      <% @page.records.group_by(&:board).each do |board, cards| %>
        <section class="card-group">
          <% unless @single_board || board.id == @continued_board_id %>
            <h2 class="card-group__title">
              <%= link_to board.name, board, data: { turbo_frame: "_top" } %>
              <span class="card-group__count"><%= @board_counts[board.id] %></span>
            </h2>
          <% end %>

          <div class="card-group__cards">
            <%= render "cards/display/previews", cards: cards %>
          </div>
        </section>
      <% end %>
    <% end %>

    <% if @page.first? && @page.records.empty? %>
      <div class="blank-slate"><%= t(".empty") %></div>
    <% end %>
  </section>
<% end %>
