<% @page_title = @board&.name || @filter.view_name || @filter.boards_label %>
<% turbo_exempts_page_from_cache %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), root_path %>
<% end %>

<% content_for :header do %>
  <div class="board-title min-w-0">
    <div class="board-title__display">
      <h1 class="board-title__name text-lg sm:text-xl font-bold truncate">
        <span class="inline-block first-letter:uppercase"><%= @page_title %></span>
      </h1>
    </div>
  </div>
<% end %>

<%# Cards grouped under their board; a list narrowed to one board needs no headings, and a
    board carried over from the page before already has one. %>
<%= turbo_frame_tag :cards_container do %>
  <section class="card-groups w-full max-w-6xl mx-auto flex flex-col gap-6 py-2 text-start">
    <%= with_automatic_pagination :cards_paginated_container, @page do %>
      <% @page.records.group_by(&:board).each do |board, cards| %>
        <section class="card-group flex flex-col gap-3">
          <% unless @single_board || board.id == @continued_board_id %>
            <h2 class="card-group__title flex items-center gap-2 text-sm font-semibold uppercase tracking-wide border-b border-base-content/20 pb-1">
              <%= link_to board.name, board, class: "link link-hover truncate", data: { turbo_frame: "_top" } %>
              <span class="badge badge-sm ms-auto"><%= @board_counts[board.id] %></span>
            </h2>
          <% end %>

          <div class="grid gap-3 grid-cols-[repeat(auto-fill,minmax(min(19rem,100%),1fr))]">
            <%= render "cards/display/previews", cards: cards %>
          </div>
        </section>
      <% end %>
    <% end %>

    <% if @page.first? && @page.records.empty? %>
      <p class="text-base-content/60 text-center py-8"><%= t(".empty") %></p>
    <% end %>
  </section>
<% end %>
