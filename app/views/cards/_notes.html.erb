<%= notes_tag(card) do %>
  <%= render partial: "cards/notes/note", collection: card.notes.preloaded.chronologically, cached: ->(note) { [ note, I18n.locale ] } %>
  <%= render "cards/notes/new", card: card %>

  <footer class="flex flex-col items-center">
    <div class="divider w-full"></div>
    <%= render "cards/delete", card: card %>
  </footer>
<% end %>
