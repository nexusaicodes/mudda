<%# The card sits on a tint of its lane's colour, with the pin beside it and the actions under it. %>
<section id="<%= dom_id(card, :card_container) %>" class="card-perma w-full max-w-4xl mx-auto mt-2 rounded-box bg-(--card-color)/20 p-3 sm:p-6 flex flex-col gap-4 text-start" style="--card-color: <%= card.color %>;" data-controller="dialog-manager">
  <% cache [ card, Date.current, I18n.locale ] do %>
    <div class="card-perma__bg flex items-start gap-3">
      <% unless card.closed? %>
        <div class="shrink-0 max-sm:hidden"><%= render "cards/container/pin", card: card %></div>
      <% end %>

      <%= card_article_tag card, class: "card bg-base-100 shadow-md grow min-w-0" do %>
        <div class="card-body gap-4">
          <header class="flex flex-wrap items-center gap-2">
            <%= render "cards/display/perma/board", card: card %>
            <%= render "cards/display/due", card: card %>
            <% unless card.closed? %>
              <div class="sm:hidden ms-auto"><%= render "cards/container/pin", card: card %></div>
            <% end %>
          </header>

          <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto]">
            <div class="flex flex-col gap-4 min-w-0">
              <%= render "cards/container/content", card: card %>
              <%= render "cards/display/perma/steps", card: card %>
            </div>

            <div class="flex flex-col items-stretch gap-2 sm:items-end">
              <%= render "cards/triage/columns", card: card %>
              <%= render "cards/display/common/stamp", card: card %>
            </div>
          </div>

          <footer class="border-t border-base-300 pt-3">
            <%= render "cards/display/common/meta", card: card %>
          </footer>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "cards/container/closure", card: card %>
</section>
