<% @page_title = @board.name %>
<% @body_class = "contained-scrolling" %>
<% turbo_exempts_page_from_cache %>

<% content_for :header do %>
  <%= render "boards/title", board: @board %>
<% end %>

<%= turbo_frame_tag :cards_container, data: {
      controller: "last-board",
      last_board_id_value: @board.id,
      last_board_key_value: last_board_storage_key } do %>
  <%= render "columns/show/add_card_button", board: @board %>
  <%= render "boards/show/columns", board: @board %>
<% end %>
