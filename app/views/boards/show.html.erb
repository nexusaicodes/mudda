<% @page_title = @board.name %>
<% @body_class = "contained-scrolling" %>
<% turbo_exempts_page_from_cache %>

<% content_for :header do %>
  <%= render "boards/title", board: @board %>
<% end %>

<%= turbo_frame_tag :cards_container do %>
  <%= render "columns/show/add_card_button", board: @board, due_soon: @due_soon %>
  <%= render "boards/show/columns", board: @board, due_soon: @due_soon %>
<% end %>
