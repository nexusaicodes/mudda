<%# A lane's header: its count in a bead of the lane's colour, then its name. board.css lays it out as a
    vertical pill while the lane is collapsed on a wide screen, and as a bar otherwise. %>
<button class="cards__expander" data-collapsible-columns-target="button" data-action="click->collapsible-columns#toggle click->navigable-list#selectCurrentOrReset"
  aria-controls="<%= column_id %>" aria-expanded="false">
  <span class="cards__expander-count" data-drag-and-drop-counter="true"><%= count > 99 ? "99+" : count %></span>
  <h2 class="cards__expander-title" data-collapsible-columns-target="title">
    <span class="truncate"><%= title %></span>
    <%= icon_tag "collapse", class: "cards__expander-collapse" %>
  </h2>
</button>
<%= yield if block_given? %>
