<div class="cards__menu" data-controller="dialog" data-dialog-orient-value="false" data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
  <button class="btn btn--circle txt-x-small borderless" data-action="click->dialog#open">
    <%= icon_tag "menu-dots-horizontal", class: "translucent" %>
    <span class="for-screen-reader">Column color</span>
  </button>

  <dialog class="popup popup--align-right panel flex-column gap-half fill-white shadow txt-small margin-block-double" data-dialog-target="dialog" data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
    <%= form_with model: column, url: board_column_path(column.board, column), method: :patch do |form| %>
      <fieldset class="flex flex-wrap gap-half">
        <legend class="txt-small">Column color</legend>
        <% Color::COLORS.each do |color| %>
          <label class="btn btn--circle" style="background: <%= color.value %>;" title="<%= color.name %>">
            <%= form.radio_button :color, color.value, checked: column.color.to_s == color.value %>
            <span class="for-screen-reader"><%= color.name %></span>
          </label>
        <% end %>
      </fieldset>
      <%= form.submit "Save color", class: "btn" %>
    <% end %>
  </dialog>
</div>
