<%# locals: (board:, due_soon:) -%>
<%# Narrows every lane to the cards due by tomorrow, overdue ones included, and back. %>
<%= link_to (due_soon ? board_path(board) : board_path(board, due: "soon")),
      class: class_names("due-toggle btn max-sm:btn-sm", "btn-active": due_soon), aria: { pressed: due_soon }, title: t(".hint") do %>
  <%= icon_tag "calendar" %>
  <span><%= t(".label") %></span>
  <span class="badge badge-sm"><%= board.cards.due_soon.count %></span>
<% end %>
