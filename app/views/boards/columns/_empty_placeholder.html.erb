<%# One hint or the other shows, depending on whether cards can be dragged here (board.css). %>
<p class="blank-slate blank-slate--default text-sm text-base-content/60 text-center py-4"><%= t(".no_cards") %></p>
<p class="blank-slate blank-slate--drag text-sm text-base-content/60 text-center py-4 truncate"><%= t(".drag_cards") %></p>
