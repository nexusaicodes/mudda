<% @page_title = t(".title") %>
<% @body_class = "compact-on-touch" %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), root_path %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= @page_title %></h1>
<% end %>

<div class="card bg-base-100 shadow-xl w-full max-w-sm m-auto">
  <%= form_with model: @board, class: "card-body gap-4", data: { controller: "form", action: "submit->form#preventEmptySubmit" } do |form| %>
    <%= form.text_field :name, required: true, class: "input w-full", autofocus: true, autocomplete: "off", placeholder: t(".placeholder"), aria: { label: t(".placeholder") }, data: { form_target: "input", action: "keydown.esc@document->form#cancel", validation_message: t(".blank") } %>

    <button type="submit" class="btn btn-primary btn-block">
      <span><%= t(".submit") %></span>
      <%= icon_tag "arrow-right" %>
    </button>

    <%= link_to t(".cancel"), root_path, data: { form_target: "cancel", turbo_frame: "_top" }, hidden: true %>
  <% end %>
</div>
