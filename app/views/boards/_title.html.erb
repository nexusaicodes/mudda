<%# locals: (board:) -%>
<%# The board's name doubles as its rename control; the ▾ beside it switches boards. %>
<div class="header__title board-title" data-controller="inline-edit">
  <div class="board-title__display" data-inline-edit-target="display">
    <h1 class="board-title__name">
      <button type="button" class="board-title__rename" data-action="inline-edit#edit" title="<%= t(".rename") %>">
        <span class="overflow-ellipsis" dir="auto"><%= board.name %></span>
      </button>
    </h1>
    <%= render "my/switcher", board: board %>
  </div>

  <div class="board-title__editor" data-inline-edit-target="editor" hidden>
    <%= form_with model: board, class: "board-title__form", data: { controller: "form", action: "submit->form#preventEmptySubmit keydown.esc->inline-edit#cancel" } do |form| %>
      <%= form.label :name, t(".name_label"), class: "for-screen-reader" %>
      <%= form.text_field :name, required: true, autocomplete: "off", class: "input board-title__input", dir: "auto",
            data: { inline_edit_target: "input", form_target: "input", validation_message: t(".blank"), "1p-ignore": "true" } %>
      <%= form.button t(".save"), class: "btn btn--link txt-small" %>
      <button type="button" class="btn txt-small" data-action="inline-edit#cancel"><%= t(".cancel") %></button>
    <% end %>
  </div>
</div>
