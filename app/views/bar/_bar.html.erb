<%# A small search pill floating at the bottom centre; it widens to a search box when used, and
    its results open in a panel above it. %>
<div class="bar" data-controller="bar" data-bar-dialog-outlet="#bar-modal"
    data-bar-search-url-value="<%= search_path %>">
  <%= tag.dialog id: "bar-modal", class: "bar__modal", data: {
        controller: "dialog", dialog_target: "dialog", dialog_orient_value: false, action: "keydown.esc@document->bar#reset:stop" } do %>
    <%= turbo_frame_tag "bar_content", data: { bar_target: "turboFrame" } %>
  <% end %>

  <div class="bar__pill">
    <button type="button" class="bar__trigger" data-bar-target="buttonsContainer" data-action="bar#search">
      <%= icon_tag "search" %>
      <span><%= t(".search") %></span>
    </button>

    <div class="bar__input" data-bar-target="search" hidden>
      <%= render "searches/form", query_terms: "", target_turbo_frame: "bar_content" %>
    </div>
  </div>
</div>
