<%# A search button in the header. It opens a panel over the dimmed page: the search box at its
    top and the results, grouped by board, below it, updating as you type. %>
<div class="bar" data-controller="bar">
  <button type="button" class="bar__trigger btn btn--circle borderless" data-action="bar#open">
    <%= icon_tag "search" %>
    <span class="for-screen-reader"><%= t(".search") %></span>
  </button>

  <dialog class="bar__panel" data-bar-target="dialog"
      data-action="click->bar#closeOnBackdrop keydown.esc->bar#close:prevent close->bar#reset">
    <div class="bar__input">
      <%= icon_tag "search", class: "bar__input-icon" %>
      <%= render "searches/form", query_terms: "", target_turbo_frame: "bar_content" %>
    </div>

    <%= turbo_frame_tag "bar_content", class: "bar__results", data: { bar_target: "turboFrame" } %>
  </dialog>
</div>
