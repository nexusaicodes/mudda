<%# Shown only under a card ceiling (MUDDA_CARD_LIMIT), with the way to lift it when MUDDA_UPGRADE_URL is set. %>
<section class="settings__section">
  <h2><%= t(".heading") %></h2>
  <p>
    <%= t(".used", count: account.cards_created_count, limit: account.card_limit) %>
    <%= t(".no_refund") %>
  </p>
  <% if account.upgrade_url %>
    <%= link_to t(".upgrade"), account_upgrade_path, class: "btn", data: { turbo: false } %>
  <% end %>
</section>
