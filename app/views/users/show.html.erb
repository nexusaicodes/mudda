<% @page_title = @user.name %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), root_path %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= t(".heading") %></h1>
<% end %>

<div class="settings">
  <div class="settings__panel panel shadow txt-align-center">
    <div class="flex flex-column gap position-relative">
      <%= link_to edit_user_path(@user), class: "user-edit-link btn", data: { controller: "tooltip" } do %>
        <%= icon_tag "pencil" %>
        <span class="for-screen-reader"><%= t(".edit") %></span>
      <% end %>

      <div class="avatar txt-xx-large center fill-white btn--circle hide-focus-ring">
        <%= image_tag user_avatar_path(@user), alt: t(".avatar_alt", name: @user.name) %>
      </div>

      <div class="flex flex-column gap-half">
        <h2 class="txt-x-large margin-none" dir="auto"><%= @user.name %></h2>
        <div class="txt-medium txt-subtle" dir="ltr"><%= @user.email_address %></div>
      </div>
    </div>
  </div>

  <div class="settings__panel panel shadow">
    <%= render "users/language" %>
  </div>

  <% if Current.account.card_limited? || Current.account.upgrade_url %>
    <div class="settings__panel panel shadow">
      <%= render "users/plan", account: Current.account %>
    </div>
  <% end %>

  <div class="settings__panel panel shadow">
    <section class="settings__section">
      <h2><%= t(".security") %></h2>
      <div class="settings__actions">
        <% if OwnerPassword.set_for?(Current.user) %>
          <%= link_to edit_my_password_path, class: "btn" do %>
            <%= icon_tag "password" %>
            <span><%= t(".change_password") %></span>
          <% end %>
        <% end %>

        <%= link_to my_passkeys_path, class: "btn" do %>
          <%= icon_tag "authentication" %>
          <span><%= t(".passkeys") %></span>
        <% end %>

        <%= link_to my_tokens_path, class: "btn" do %>
          <%= icon_tag "bolt" %>
          <span><%= t(".tokens") %></span>
        <% end %>
      </div>
    </section>
  </div>

  <%= button_to t(".sign_out"), session_path, method: :delete, class: "settings__sign-out", form: { class: "settings__sign-out-form", data: { turbo: false, controller: "clear-offline-cache", action: "submit->clear-offline-cache#clearCache" } } %>
</div>
