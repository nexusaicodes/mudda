<% @page_title = @user.name %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), root_path %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= t(".heading") %></h1>
<% end %>

<div class="settings w-full max-w-xl mx-auto flex flex-col gap-4 text-start">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body items-center text-center gap-3 relative">
      <%= link_to edit_user_path(@user), class: "user-edit-link btn btn-ghost btn-circle btn-sm absolute top-3 end-3", title: t(".edit"), aria: { label: t(".edit") } do %>
        <%= icon_tag "pencil" %>
      <% end %>

      <div class="avatar">
        <div class="w-24 rounded-full">
          <%= image_tag user_avatar_path(@user), alt: t(".avatar_alt", name: @user.name) %>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold" dir="auto"><%= @user.name %></h2>
        <div class="text-base-content/60" dir="ltr"><%= @user.email_address %></div>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body"><%= render "users/language" %></div>
  </div>

  <% if Current.account.card_limited? || Current.account.upgrade_url %>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body"><%= render "users/plan", account: Current.account %></div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-sm">
    <div class="card-body gap-3">
      <h2 class="card-title text-base"><%= t(".security") %></h2>
      <ul class="list -mx-2">
        <% if OwnerPassword.set_for?(Current.user) %>
          <li><%= link_to edit_my_password_path, class: "list-row items-center hover:bg-base-200 rounded-field" do %>
            <%= icon_tag "password" %><span><%= t(".change_password") %></span><%= icon_tag "arrow-right", class: "opacity-50" %>
          <% end %></li>
        <% end %>
        <li><%= link_to my_passkeys_path, class: "list-row items-center hover:bg-base-200 rounded-field" do %>
          <%= icon_tag "authentication" %><span><%= t(".passkeys") %></span><%= icon_tag "arrow-right", class: "opacity-50" %>
        <% end %></li>
        <li><%= link_to my_tokens_path, class: "list-row items-center hover:bg-base-200 rounded-field" do %>
          <%= icon_tag "bolt" %><span><%= t(".tokens") %></span><%= icon_tag "arrow-right", class: "opacity-50" %>
        <% end %></li>
      </ul>
    </div>
  </div>

  <%= button_to t(".sign_out"), session_path, method: :delete, class: "settings__sign-out btn btn-block", form: { data: { turbo: false, controller: "clear-offline-cache", action: "submit->clear-offline-cache#clearCache" } } %>
</div>
