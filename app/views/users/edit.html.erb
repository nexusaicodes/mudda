<% @page_title = t(".title") %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), user_path(@user) %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= @page_title %></h1>
<% end %>

<div class="card bg-base-100 shadow-xl w-full max-w-sm m-auto text-start">
  <div class="card-body gap-4">
    <%= form_with model: @user, method: :patch, class: "flex flex-col gap-4", data: { controller: "form upload-preview" } do |form| %>
      <div class="flex items-end justify-center gap-2">
        <label class="avatar cursor-pointer" title="<%= t(".avatar_label", name: @user.name) %>">
          <div class="w-32 rounded-full ring-2 ring-base-300 ring-offset-2 ring-offset-base-100">
            <%= image_tag user_avatar_path(@user), aria: { hidden: "true" }, size: 128, data: { upload_preview_target: "image" } %>
          </div>
          <%= form.file_field :avatar, id: "file", class: "sr-only", accept: User::Avatar::ALLOWED_AVATAR_CONTENT_TYPES.join(","),
                data: { upload_preview_target: "input", action: "upload-preview#previewImage" } %>
          <span class="sr-only"><%= t(".avatar_label", name: @user.name) %></span>
        </label>

        <% if @user.avatar.attached? %>
          <%= tag.button type: :submit, form: "avatar-delete-form", class: "btn btn-ghost btn-circle btn-sm text-error", aria: { label: t(".delete_avatar") }, data: { turbo_confirm: t(".confirm_delete_avatar") } do %>
            <%= icon_tag "minus" %>
          <% end %>
        <% end %>
      </div>

      <fieldset class="fieldset p-0">
        <%= form.label :name, t(".name_label"), class: "fieldset-legend" %>
        <%= form.text_field :name, class: "input w-full", autocomplete: "name", dir: "auto", autofocus: true, required: true, data: { "1p-ignore": true, action: "keydown.esc@document->form#cancel" } %>
      </fieldset>
      <fieldset class="fieldset p-0">
        <%= form.label :email_address, t(".email_label"), class: "fieldset-legend" %>
        <%= form.email_field :email_address, class: "input w-full bg-base-200", autocomplete: "username", required: true, readonly: true, value: @user.email_address %>
      </fieldset>

      <% if @user.errors.any? %>
        <div role="alert" class="alert alert-error alert-soft text-sm flex-col items-start">
          <p class="font-bold"><%= t(".errors_heading") %></p>
          <ul class="list-disc ps-5">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <button type="submit" id="log_in" class="btn btn-primary btn-block" data-form-target="submit">
        <span><%= t(".save") %></span>
      </button>

      <%= link_to t(".cancel"), user_path(@user), data: { form_target: "cancel", turbo_frame: "_top" }, hidden: true %>
    <% end %>

    <%= form_with url: user_avatar_url(@user), method: :delete, id: "avatar-delete-form" %>
  </div>
</div>
