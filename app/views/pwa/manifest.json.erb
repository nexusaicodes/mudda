{
  "lang": <%= I18n.locale.to_s.to_json.html_safe %>,
  "dir": <%= (I18n.locale == :ar ? "rtl" : "ltr").to_json.html_safe %>,
  "name": <%= [ t(".name"), Rails.env.production? ? nil : Rails.env ].compact.join(" - ").to_json.html_safe %>,
  "icons": [
    {
      "src": "/app-icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/app-icon.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "/app-icon-192-maskable.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": <%= t(".description").to_json.html_safe %>,
  "categories": ["bugs", "business", "productivity"],
  "shortcuts": [
    {
      "name": <%= t(".home.name").to_json.html_safe %>,
      "description": <%= t(".home.description").to_json.html_safe %>,
      "url": "<%= root_path %>",
      "icons": [{ "src": "<%= image_url("home.svg") %>", "sizes": "any" }]
    }
  ]
}
