<% @page_title = t(".title") %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), my_tokens_path %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= @page_title %></h1>
<% end %>

<section class="panel panel--wide shadow center txt-align-start flex flex-column gap">
  <p class="margin-none">
    <%= t(".summary_html", label: tag.strong(@token.label, dir: "auto"), scopes: tag.strong(@token.scopes.to_sentence),
          date: l(@token.expires_at.to_date, format: :app_long)) %>
  </p>

  <div class="flex align-center gap-half" data-controller="clipboard">
    <%= text_field_tag :token, @token.token, readonly: true, class: "input", style: "font-family: var(--font-mono)", data: { clipboard_target: "source", action: "focus->clipboard#select" } %>
    <button type="button" class="btn" data-action="clipboard#copy">
      <%= icon_tag "copy-paste" %>
      <span class="for-screen-reader"><%= t(".copy") %></span>
    </button>
  </div>

  <div class="flex flex-column gap-half">
    <strong><%= t(".mcp") %></strong>
    <code class="txt-small" style="overflow-wrap: anywhere">claude mcp add --transport http mudda <%= request.base_url %>/mcp --header "Authorization: Bearer &lt;token&gt;"</code>
  </div>

  <div class="flex flex-column gap-half">
    <strong><%= t(".api") %></strong>
    <code class="txt-small" style="overflow-wrap: anywhere">curl -H "Authorization: Bearer &lt;token&gt;" <%= request.base_url %>/boards.json</code>
  </div>
</section>
