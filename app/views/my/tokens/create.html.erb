<% @page_title = t(".title") %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), my_tokens_path %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= @page_title %></h1>
<% end %>

<section class="card bg-base-100 shadow-sm w-full max-w-2xl mx-auto p-6 text-start gap-4 flex-none">
  <p class="m-0">
    <%= t(".summary_html", label: tag.strong(@token.label, dir: "auto"), scopes: tag.strong(@token.scopes.to_sentence),
          date: l(@token.expires_at.to_date, format: :app_long)) %>
  </p>

  <div class="join w-full" data-controller="clipboard">
    <%= text_field_tag :token, @token.token, readonly: true, class: "input join-item w-full font-mono", aria: { label: t(".copy") }, data: { clipboard_target: "source", action: "focus->clipboard#select" } %>
    <button type="button" class="btn join-item" data-action="clipboard#copy" aria-label="<%= t(".copy") %>">
      <%= icon_tag "copy-paste" %>
    </button>
  </div>

  <div class="flex flex-col gap-2">
    <strong><%= t(".mcp") %></strong>
    <code class="text-sm break-all bg-base-200 rounded-field p-2">claude mcp add --transport http mudda <%= request.base_url %>/mcp --header "Authorization: Bearer &lt;token&gt;"</code>
  </div>

  <div class="flex flex-col gap-2">
    <strong><%= t(".api") %></strong>
    <code class="text-sm break-all bg-base-200 rounded-field p-2">curl -H "Authorization: Bearer &lt;token&gt;" <%= request.base_url %>/boards.json</code>
  </div>
</section>
