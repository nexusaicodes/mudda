<% @page_title = "API tokens" %>

<% content_for :header do %>
  <div class="header__actions header__actions--start">
    <%= back_link_to "My profile", user_path(Current.user), "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
  </div>

  <h1 class="header__title"><%= @page_title %></h1>
<% end %>

<section class="panel panel--wide shadow center txt-align-start flex flex-column gap">
  <p class="font-weight-medium margin-none">
    A token lets a script or an AI agent use Mudda as you, through the API or MCP. Give each one its own
    name, so you can tell what it did and revoke it on its own.
  </p>

  <% if @tokens.any? %>
    <ul class="margin-none unpad">
      <%= render partial: "my/tokens/token", collection: @tokens %>
    </ul>
  <% end %>

  <%= form_with model: @token, scope: :token, url: my_tokens_path, data: { turbo: false }, html: { class: "flex flex-column gap" } do |form| %>
    <strong>Mint a token</strong>

    <% if @token.errors.any? %>
      <p class="txt-negative margin-none"><%= @token.errors.full_messages.to_sentence %></p>
    <% end %>

    <div class="flex flex-column gap-half">
      <%= form.label :label, "Name" %>
      <%= form.text_field :label, class: "input", placeholder: "e.g. claude, cursor, backup-script", required: true,
            autocomplete: "off", data: { "1p-ignore": "" } %>
      <span class="txt-small txt-subtle">Minting under a name already in use replaces that token.</span>
    </div>

    <fieldset class="flex flex-column gap-half borderless unpad margin-none">
      <legend class="margin-block-end-half">What it may do</legend>
      <%= hidden_field_tag "token[scopes][]", "", id: nil %>
      <% scope_descriptions.each do |scope, description| %>
        <label class="flex align-center gap-half">
          <%= check_box_tag "token[scopes][]", scope, @token.scopes.include?(scope), id: "token_scope_#{scope}" %>
          <span><strong><%= scope %></strong> — <%= description %></span>
        </label>
      <% end %>
    </fieldset>

    <%= form.submit "Mint token", class: "btn btn--link center" %>
  <% end %>
</section>
