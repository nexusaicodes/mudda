<% @page_title = t(".title") %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), user_path(Current.user) %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= @page_title %></h1>
<% end %>

<section class="card bg-base-100 shadow-sm w-full max-w-2xl mx-auto p-6 text-start gap-4 flex-none">
  <p class="font-medium m-0">
    <%= t(".intro") %>
  </p>

  <% if @tokens.any? %>
    <ul class="list bg-base-200/40 rounded-box">
      <%= render partial: "my/tokens/token", collection: @tokens %>
    </ul>
  <% end %>

  <%= form_with model: @token, scope: :token, url: my_tokens_path, data: { turbo: false }, html: { class: "flex flex-col gap-4" } do |form| %>
    <h2 class="text-base m-0"><%= t(".mint_heading") %></h2>

    <% if @token.errors.any? %>
      <p role="alert" class="alert alert-error alert-soft text-sm"><%= @token.errors.full_messages.to_sentence %></p>
    <% end %>

    <div class="fieldset p-0">
      <%= form.label :label, t(".name"), class: "fieldset-legend" %>
      <%= form.text_field :label, class: "input w-full", placeholder: t(".placeholder"), required: true,
            autocomplete: "off", data: { "1p-ignore": "" } %>
      <span class="text-sm text-base-content/60"><%= t(".replace_hint") %></span>
    </div>

    <fieldset class="fieldset p-0 gap-2">
      <legend class="fieldset-legend"><%= t(".scopes_legend") %></legend>
      <%= hidden_field_tag "token[scopes][]", "", id: nil %>
      <% scope_descriptions.each do |scope, description| %>
        <label class="flex items-center gap-2">
          <%= check_box_tag "token[scopes][]", scope, @token.scopes.include?(scope), id: "token_scope_#{scope}", class: "checkbox checkbox-sm" %>
          <span><strong><%= scope %></strong> — <%= description %></span>
        </label>
      <% end %>
    </fieldset>

    <%= form.submit t(".submit"), class: "btn btn-primary self-center" %>
  <% end %>
</section>
