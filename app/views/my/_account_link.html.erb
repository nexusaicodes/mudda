<%# The avatar opens the profile, which holds the plan, passkeys, API tokens, and sign out. %>
<%= link_to user_path(Current.user), class: "account-link avatar btn btn-ghost btn-circle", aria: { label: t(".profile") } do %>
  <div class="w-9 rounded-full"><%= avatar_image_tag Current.user, alt: "" %></div>
<% end %>
