<% @page_title = t(".title") %>

<% content_for :header_start do %>
  <%= back_link_to t(".back"), my_passkeys_path %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= @page_title %></h1>
<% end %>

<section class="panel panel--wide shadow center txt-align-start flex flex-column gap">
  <% if params[:created] %>
    <p class="margin-none"><%= t(".created") %></p>
  <% end %>

  <%= form_with model: @passkey, scope: :passkey, url: my_passkey_path(@passkey), html: { class: "flex flex-column gap" } do |form| %>
    <div class="flex flex-column gap-half">
      <strong><%= form.label :name, t(".name_label") %></strong>
      <%= form.text_field :name, autofocus: true, class: "input", dir: "auto", placeholder: t(".placeholder"), data: { "1p-ignore": "" }, autocomplete: "off" %>
    </div>

    <%= form.submit t(".save"), class: "btn btn--link center" %>
  <% end %>

  <div class="txt-align-center">
    <%= button_to my_passkey_path(@passkey), method: :delete,
          class: "btn txt-negative borderless txt-small",
          data: { turbo_confirm: t(".confirm_remove") } do %>
      <%= icon_tag "trash" %>
      <span><%= t(".remove") %></span>
    <% end %>
  </div>
</section>
