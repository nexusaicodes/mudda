<%= turbo_frame_tag "my_menu", target: "_top" do %>
  <%= nav_section t(".boards") do %>
    <% @boards.each do |board| %>
      <%= menu_item board.name, board_path(board), icon: "board", dir: "auto", current: board == @current_board %>
    <% end %>
    <%= menu_item t(".new_board"), new_board_path, icon: "add" %>
  <% end %>

  <%= nav_section t(".views") do %>
    <% @views.each do |view, count| %>
      <%= menu_item view.name, cards_path(view.params), icon: view.icon, count: count,
            current: view.key.to_s == @current_view, muted: count.zero? %>
    <% end %>
  <% end %>

  <% if @current_board %>
    <div class="menu__footer">
      <%= render "boards/delete", board: @current_board %>
    </div>
  <% end %>
<% end %>
