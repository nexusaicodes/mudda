<%= form_with url: search_path, method: :get,
  class: "search__form flex items-center gap-2",
  data: {
    controller: "search-form",
    action: "search-form:reset->bar#close",
    bar_target: "form",
    turbo_action: defined?(turbo_action) ? turbo_action : nil,
    turbo_frame: defined?(target_turbo_frame) ? target_turbo_frame : nil } do |form| %>
  <label class="input input-ghost grow focus-within:outline-none">
    <%= icon_tag "search", class: "opacity-60" %>
    <%= text_field_tag :q, query_terms,
          class: "search__input grow [&::-webkit-search-cancel-button]:appearance-none",
          aria: { label: t(".label") },
          type: "search",
          placeholder: t(".placeholder"),
          autocomplete: "off",
          autofocus: true,
          data: {
            search_form_target: "searchInput",
            bar_target: "searchInput",
            action: "input->bar#searchAsYouType keydown.enter->bar#submit:prevent" } %>
  </label>
  <button hidden><%= t(".submit") %></button>
  <button class="search__reset btn btn-ghost btn-circle btn-sm" data-action="search-form#clearInput" aria-label="<%= t(".close") %>">
    <%= icon_tag "close" %>
  </button>
<% end %>
