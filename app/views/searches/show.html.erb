<% @page_title = @query ? t(".title_with_query", query: @query) : t(".title") %>

<% content_for :header_start do %>
  <%= back_link_to t(".home"), root_path %>
<% end %>

<% content_for :header do %>
  <h1 class="text-lg sm:text-xl font-bold truncate"><%= @page_title %></h1>
<% end %>

<div class="search-perma card bg-base-100 shadow-sm w-full max-w-2xl mx-auto mt-2">
  <div class="p-3 border-b border-base-300">
    <%= render "form", query_terms: @query, turbo_action: "advance", target_turbo_frame: "bar_content" %>
  </div>
  <%= turbo_frame_tag "bar_content" do %>
    <%= render "results", groups: @groups, query: @query %>
  <% end %>
</div>
