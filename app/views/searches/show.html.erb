<% @page_title = @query ? "Search results for \"#{@query}\"" : "Search" %>

<% content_for :header_start do %>
  <%= back_link_to "Home", root_path %>
<% end %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
<% end %>

<div class="search-perma margin-block-start">
  <%= render "form", query_terms: @query, turbo_action: "advance", target_turbo_frame: "bar_content" %>
  <%= turbo_frame_tag "bar_content" do %>
    <%= render "results", groups: @groups, query: @query %>
  <% end %>
</div>
