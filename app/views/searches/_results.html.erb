<%# locals: (groups:, query:) -%>
<section class="search">
  <% if query && groups.empty? %>
    <div class="search__blank-slate blank-slate">No matches</div>
  <% end %>

  <% groups.each do |board, cards| %>
    <section class="search__group">
      <h3 class="search__group-title">
        <span class="overflow-ellipsis"><%= board.name %></span>
        <span class="search__group-count"><%= cards.size %></span>
      </h3>

      <ul class="search__list">
        <% cards.first(5).each do |card, matches| %>
          <%= render "searches/result", card: card, matches: matches %>
        <% end %>
      </ul>

      <% if cards.size > 5 %>
        <%= link_to "Show all #{cards.size} →", cards_path(board_ids: [ board.id ], terms: [ query ]),
              class: "search__more btn btn--plain txt-small", data: { turbo_frame: "_top", action: "bar#reset" } %>
      <% end %>
    </section>
  <% end %>
</section>
