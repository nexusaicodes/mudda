<%# locals: (groups:, query:) -%>
<section class="search flex flex-col gap-3 p-3 text-start">
  <% if query && groups.empty? %>
    <p class="search__blank-slate text-sm text-base-content/60 text-center py-4"><%= t(".no_matches") %></p>
  <% end %>

  <% groups.each do |board, count, cards| %>
    <section class="search__group">
      <h3 class="search__group-title flex items-center gap-2 px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-base-content/60">
        <span class="truncate" dir="auto"><%= board.name %></span>
        <span class="badge badge-sm ms-auto"><%= count %></span>
      </h3>

      <ul class="search__list list">
        <% cards.each do |card, matches| %>
          <%= render "searches/result", card: card, matches: matches %>
        <% end %>
      </ul>

      <% if count > cards.size %>
        <%= link_to t(".show_all", count: count), cards_path(board_ids: [ board.id ], terms: [ query ]),
              class: "search__more btn btn-ghost btn-sm mt-1", data: { turbo_frame: "_top", action: "bar#close" } %>
      <% end %>
    </section>
  <% end %>
</section>
