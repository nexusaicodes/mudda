<%# locals: (card:, matches:) -%>
<%# One row per card: the title, then where the query matched — its description, or a note. %>
<% title_match = matches.find { |match| match.note.nil? } || matches.first %>
<% note_match = matches.find(&:note) %>

<li>
  <%= link_to board_card_path(card.board, card), class: "search__result", style: "--card-color: #{card.color}",
        data: { turbo_frame: "_top", action: "bar#reset" } do %>
    <div class="search__result-main">
      <h4 class="search__title margin-none"><%= title_match.card_title %></h4>

      <% if title_match.note.nil? && (description = title_match.card_description).present? %>
        <div class="search__excerpt"><%= description %></div>
      <% elsif note_match %>
        <div class="search__excerpt search__excerpt--note">in a note: “<%= note_match.note_body %>”</div>
      <% end %>
    </div>

    <div class="search__meta">
      <span class="search__lane" style="--column-color: <%= card.column.color %>"><%= card.column.name %></span>
      <%= render "cards/display/preview/due", card: card %>
    </div>
  <% end %>
</li>
