# Non-secret deploy parameters. Copy to config.env and fill in, then the
# deploy/ec2 scripts read it. Secrets (owner password, Rails secret) are NEVER
# put here — they are gathered at run time and pushed straight to GitHub secrets.
#
#   cp config.example.env config.env && $EDITOR config.env

# Your fork of the repo, "owner/repo". The deploy pipeline builds the image to
# ghcr.io/<owner>/<repo> and Actions runs from here, so this must be YOUR repo.
GH_REPO=your-github-user/mudda

# AWS region to launch the box in.
AWS_REGION=us-east-1

# Instance sizing. t3.small (2 GB) is a comfortable floor for Rails + SQLite.
INSTANCE_TYPE=t3.small
VOLUME_SIZE_GB=20

# Optional. Leave unset to launch into the region's default VPC (provision.sh
# fails with a clear message if there isn't one). Set to a subnet id only if
# your account has no default VPC, or you want a specific subnet.
# SUBNET_ID=subnet-0123456789abcdef0

# Tag/name used to find-or-create every AWS resource. Keep it stable so re-runs
# reuse the same box, Elastic IP, and security group instead of duplicating them.
TAG=mudda-box

# SSH. SSH_USER is the EC2 Ubuntu AMI default (uid 1000 — matches the container).
# SSH_KEY is your admin keypair; CI_DEPLOY_KEY is a separate, revocable key that
# only GitHub Actions uses. Both are created automatically if missing.
SSH_USER=ubuntu
# SSH_KEY=~/.ssh/mudda_box
# CI_DEPLOY_KEY=~/.ssh/mudda_deploy
